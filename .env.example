# Local Docker PostgreSQL. For Supabase use its direct or pooler PostgreSQL URL.
DATABASE_URL=postgresql://ntp:ntp_dev_only@127.0.0.1:5433/ntp_audit
# Generate a random 32+ character value. Never commit the real value.
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
# Optional; defaults to .data/uploads outside Git.
PRIVATE_UPLOAD_DIR=.data/uploads
# Supabase production settings. Obtain the PostgreSQL URL and service-role key
# from the NTP Audit project dashboard; never expose the service-role key in browser code.
# SUPABASE_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-...pooler.supabase.com:6543/postgres
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
# SUPABASE_STORAGE_BUCKET=ntp-private-uploads
# Optional: certificate from Supabase Database Settings > SSL Configuration.
# SUPABASE_SSL_ROOT_CERT=C:\path\to\prod-supabase.crt
# Required on first setup. Remove ADMIN_PASSWORD after db:setup creates the admin account.
# ADMIN_EMAIL=admin@company.com
# ADMIN_PASSWORD=use-a-unique-password-of-at-least-12-characters
# COMPANY_NAME=บริษัทของฉัน
