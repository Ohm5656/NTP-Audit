# The deployed app URL. Use http://localhost:3000 only when testing locally.
NTP_APP_URL=https://your-vercel-domain.vercel.app
# Use the exact same 32+ character value configured as EXPORT_WORKER_TOKEN on Vercel.
EXPORT_WORKER_TOKEN=replace-with-a-random-32-character-or-longer-token
# Optional; the Worker checks for queued jobs at this interval.
WORKER_POLL_INTERVAL_MS=5000
